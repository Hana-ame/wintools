#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn ( ) {
    echo "$*"
} >&2

die ( ) {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "`uname`" in
    CYGWIN* )
        cygwin=true
        ;;
    Darwin* )
        darwin=true
        ;;
    MINGW* )
        msys=true
        ;;
    NONSTOP* )
        nonstop=true
        ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Gradle home
APP_HOME=`dirname "$APP_BASE_NAME"`

# Add default JVM options here
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Collect all arguments for the java command
JAVA_OPTS=""
JVM_OPTS=""
GRADLE_OPTS=""

for i do
    case "$i" in
        -*:*=*)
            opt=`echo "$i" | cut -d'=' -f1`
            arg=`echo "$i" | cut -d'=' -f2-`
            case "$opt" in
                -D*)
                    JAVA_OPTS="$JAVA_OPTS $opt=$arg"
                    ;;
                -J-*)
                    JVM_OPTS="$JVM_OPTS ${i/-J/}"
                    ;;
                *)
                    GRADLE_OPTS="$GRADLE_OPTS $i"
                    ;;
            esac
            ;;
        *)
            GRADLE_OPTS="$GRADLE_OPTS $i"
            ;;
    esac
done

exec java $JAVA_OPTS $JVM_OPTS $GRADLE_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
